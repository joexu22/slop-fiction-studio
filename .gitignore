# =============================================================================
# Local Secrets & Environment (never commit real creds)
# =============================================================================
# Actual secret files
.env
.env.local
.env.*.local
.envrc
# Allow committed templates/examples so a fresh clone + config file "just works"
!.env.template
!.env.example
!.env.*.example
!.env.*.template
!dotenv.template
!sample.env
!**/.*.env.example
!**/.*.env.template
!**/sample.env

